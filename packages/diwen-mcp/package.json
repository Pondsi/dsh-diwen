  },
  "files": [
    "server.mjs",
    "selftest.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "selftest": "node selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
